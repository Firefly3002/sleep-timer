<Window x:Class="SleepTimer.Desktop.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sleep Timer" Width="760" Height="620" Topmost="True" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Foreground="{StaticResource BrightText}" FontFamily="Segoe UI"
        Closing="Window_Closing" KeyDown="Window_KeyDown">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PromptCard" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.42" />
                    <DoubleAnimation Storyboard.TargetName="PromptEnterTransform" Storyboard.TargetProperty="Y"
                                     From="16" To="0" Duration="0:0:0.46">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="MoonBadgeTransform" Storyboard.TargetProperty="ScaleX"
                                     From="0.96" To="1.04" Duration="0:0:2.4" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="MoonBadgeTransform" Storyboard.TargetProperty="ScaleY"
                                     From="0.96" To="1.04" Duration="0:0:2.4" AutoReverse="True" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid Background="#E70A1323">
        <Image Source="/SleepTimer;component/Assets/night-banner.png" Stretch="UniformToFill" Opacity="0.15"
               IsHitTestVisible="False" />
        <Border x:Name="PromptCard" MaxWidth="560" Padding="42,38" CornerRadius="30"
                Background="#14243A" BorderBrush="#3A506E" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><TranslateTransform x:Name="PromptEnterTransform" Y="16" /></Border.RenderTransform>
            <StackPanel HorizontalAlignment="Stretch">
                <Border x:Name="MoonBadge" Width="62" Height="62" CornerRadius="22" Background="#243850"
                        HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="MoonBadgeTransform" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                    <TextBlock Text="☾" FontFamily="Segoe UI Symbol" FontSize="42" Foreground="{StaticResource MoonGold}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                </Border>
                <TextBlock Text="Your timer is almost up" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                <TextBlock x:Name="ActionText" Text="Snooze for more time, or cancel the timer to stop the selected action." FontSize="15" Foreground="{StaticResource SoftText}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0" />
                <TextBlock x:Name="CountdownLabel" Text="Sleep begins in" FontSize="12" Foreground="{StaticResource SoftText}"
                           HorizontalAlignment="Center" Margin="0,28,0,0" />
                <TextBlock x:Name="CountdownText" Text="01:00" FontSize="44" FontWeight="Light" Foreground="{StaticResource MoonGold}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <ProgressBar x:Name="WarningProgress" Height="5" Minimum="0" Maximum="100" Value="0" Margin="0,18,0,0"
                             Background="#344760" Foreground="#D6BD7D" BorderThickness="0" />
                <Button x:Name="SnoozeButton" Content="Snooze 15 minutes" MinHeight="58" Margin="0,27,0,0"
                        FontSize="17" Background="#8CC7B1" BorderBrush="#8CC7B1" Foreground="#10231F"
                        Click="SnoozeButton_Click" />
                <Button Content="Cancel timer" MinHeight="48" Margin="0,10,0,0" Background="#472F3B"
                        BorderBrush="#765061" Foreground="#FFD8DF"
                        Click="CancelButton_Click" />
                <TextBlock Text="Cancel stops this timer. Snooze starts another interval." FontSize="11" Foreground="#91A3BB"
                           HorizontalAlignment="Center" Margin="0,15,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

