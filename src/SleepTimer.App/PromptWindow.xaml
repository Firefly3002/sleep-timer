<Window x:Class="SleepTimer.Desktop.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sleep Timer" Width="760" Height="620" Topmost="True" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Foreground="{StaticResource BrightText}" FontFamily="Segoe UI"
        Closing="Window_Closing" KeyDown="Window_KeyDown">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PromptCard" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.42" />
                    <DoubleAnimation Storyboard.TargetName="PromptEnterTransform" Storyboard.TargetProperty="Y"
                                     From="16" To="0" Duration="0:0:0.46">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="MoonBadgeTransform" Storyboard.TargetProperty="ScaleX"
                                     From="0.96" To="1.04" Duration="0:0:2.4" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="MoonBadgeTransform" Storyboard.TargetProperty="ScaleY"
                                     From="0.96" To="1.04" Duration="0:0:2.4" AutoReverse="True" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid x:Name="PromptBackdrop" Background="#E70A1323"
          PreviewMouseLeftButtonDown="PromptBackdrop_PreviewMouseLeftButtonDown">
        <Image Source="/SleepTimer;component/Assets/night-banner.png" Stretch="UniformToFill" Opacity="0.15"
               IsHitTestVisible="False" />
        <Border x:Name="PromptCard" MaxWidth="560" Padding="32,30" CornerRadius="26"
                Background="#14243A" BorderBrush="#3A506E" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><TranslateTransform x:Name="PromptEnterTransform" Y="16" /></Border.RenderTransform>
            <StackPanel HorizontalAlignment="Stretch">
                <Border x:Name="MoonBadge" Width="56" Height="56" CornerRadius="20" Background="#243850"
                        HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="MoonBadgeTransform" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                    <TextBlock Text="☾" FontFamily="Segoe UI Symbol" FontSize="38" Foreground="{StaticResource MoonGold}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                </Border>
                <TextBlock x:Name="PromptHeadline" Text="Your timer is almost up" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="ActionText" Text="Snooze for more time, or cancel the timer to stop the selected action." FontSize="15" Foreground="{StaticResource SoftText}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="CountdownLabel" Text="Sleep begins in" FontSize="12" Foreground="{StaticResource SoftText}"
                           HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock x:Name="CountdownText" Text="01:00" FontSize="40" FontWeight="Light" Foreground="{StaticResource MoonGold}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <ProgressBar x:Name="WarningProgress" Height="5" Minimum="0" Maximum="100" Value="0" Margin="0,14,0,0"
                             Background="#344760" Foreground="#D6BD7D" BorderThickness="0" />
                <Button x:Name="SnoozeButton" Content="Snooze 15 minutes" MinHeight="52" Margin="0,20,0,0"
                        FontSize="17" Background="#8CC7B1" BorderBrush="#8CC7B1" Foreground="#10231F"
                        Click="SnoozeButton_Click" />
                <Button x:Name="CancelButton" Content="Cancel timer" MinHeight="44" Margin="0,9,0,0" Background="#472F3B"
                        BorderBrush="#765061" Foreground="#FFD8DF"
                        Click="CancelButton_Click" />
                <TextBlock x:Name="FooterNotice" Text="Cancel stops this timer. Snooze starts another interval." FontSize="11" Foreground="#91A3BB"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
        <Border x:Name="PromptTitleBar" Height="36" Margin="14,3,14,0" VerticalAlignment="Top"
                CornerRadius="9" Background="#14243A" BorderBrush="#304765" BorderThickness="1" Visibility="Collapsed">
            <DockPanel Margin="9,0,0,0">
                <Button x:Name="PromptTitleCloseButton" DockPanel.Dock="Right" Content="×" Width="32" Height="28" MinHeight="28" Padding="0"
                        FontSize="17" FontWeight="Normal" Background="#422B3A" BorderBrush="#765061"
                        Foreground="#FFE2E8" ToolTip="Cancel timer" Click="CancelButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/SleepTimer;component/Assets/sleep-timer.png" Width="20" Height="20" />
                    <TextBlock x:Name="PromptTitleText" Text="Sleep Timer · Warning" FontSize="12" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#E7ECF5" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

