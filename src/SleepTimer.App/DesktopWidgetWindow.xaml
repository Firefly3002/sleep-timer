<Window x:Class="SleepTimer.Desktop.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sleep Timer Widget" Width="164" Height="60" MinWidth="150" MinHeight="56"
        Topmost="True" ShowInTaskbar="False" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI"
        Foreground="{StaticResource BrightText}" WindowStartupLocation="Manual"
        UseLayoutRounding="True" Closing="Window_Closing"
        PreviewMouseLeftButtonDown="Widget_ClickOrDrag"
        PreviewMouseLeftButtonUp="Widget_ClickOrDrag_MouseLeftButtonUp"
        PreviewMouseMove="Widget_ClickOrDrag_MouseMove">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="30"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="WidgetBackgroundArtwork" Storyboard.TargetProperty="Opacity"
                                     From="0.54" To="0.64" Duration="0:0:5" AutoReverse="True" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Border x:Name="WidgetPill" Margin="3" CornerRadius="30" Background="#203A59"
            BorderBrush="#436184" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="WidgetProgressHost" SizeChanged="WidgetProgressHost_SizeChanged" ClipToBounds="True">
            <Image x:Name="WidgetBackgroundArtwork" Source="/SleepTimer;component/Assets/widget-night-background.png"
                   Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   Opacity="0.6" Panel.ZIndex="0" IsHitTestVisible="False" />
            <Border x:Name="WidgetProgressFill" Width="0" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    CornerRadius="29" Background="#07172D" Opacity="1" Panel.ZIndex="1" IsHitTestVisible="False" />
            <Grid x:Name="WidgetClickSurface" Background="Transparent"
                  LostMouseCapture="Widget_ClickOrDrag_LostMouseCapture"
                  Panel.ZIndex="2"
                  ToolTip="Click to open Sleep Timer · drag to move · resize from the corner">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <!-- Dark offset copies create a crisp outline around the time over the changing widget background. -->
                    <TextBlock Text="{Binding Text, ElementName=WidgetTimeText}" FontSize="25" FontWeight="Bold"
                               Foreground="#06152B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform><TranslateTransform X="-1" Y="-1" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding Text, ElementName=WidgetTimeText}" FontSize="25" FontWeight="Bold"
                               Foreground="#06152B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform><TranslateTransform X="0" Y="-1" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding Text, ElementName=WidgetTimeText}" FontSize="25" FontWeight="Bold"
                               Foreground="#06152B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform><TranslateTransform X="1" Y="-1" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding Text, ElementName=WidgetTimeText}" FontSize="25" FontWeight="Bold"
                               Foreground="#06152B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform><TranslateTransform X="-1" Y="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding Text, ElementName=WidgetTimeText}" FontSize="25" FontWeight="Bold"
                               Foreground="#06152B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform><TranslateTransform X="1" Y="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding Text, ElementName=WidgetTimeText}" FontSize="25" FontWeight="Bold"
                               Foreground="#06152B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform><TranslateTransform X="-1" Y="1" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding Text, ElementName=WidgetTimeText}" FontSize="25" FontWeight="Bold"
                               Foreground="#06152B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform><TranslateTransform X="0" Y="1" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding Text, ElementName=WidgetTimeText}" FontSize="25" FontWeight="Bold"
                               Foreground="#06152B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.RenderTransform><TranslateTransform X="1" Y="1" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="WidgetTimeText" Text="02:00:00" FontSize="25" FontWeight="Bold"
                               Foreground="{StaticResource BrightText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
