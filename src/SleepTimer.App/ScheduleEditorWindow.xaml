<Window x:Class="SleepTimer.Desktop.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Schedule timer" Width="560" Height="700" MinWidth="500" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource BrightText}" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="5" CornerRadius="18"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Margin="6" CornerRadius="18" Background="{StaticResource NightBackground}"
            BorderBrush="#566987" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="17,17,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <ImageBrush ImageSource="/SleepTimer;component/Assets/night-banner.png" Stretch="UniformToFill" Opacity="0.18" />
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Image Source="/SleepTimer;component/Assets/sleep-timer.png" Width="28" Height="28" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="EditorTitleText" Text="Add schedule" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="WEEKLY COUNTDOWN" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MoonGold}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="×" Width="32" Height="30" MinHeight="30" Padding="0"
                            FontWeight="Normal" Background="#293B56" BorderBrush="#425875" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,14,0" Click="CancelButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cancel" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Margin="22,15,22,12">
                <StackPanel>
                    <TextBlock Text="The selected time starts your saved countdown. You can skip it and go straight to the warning."
                               FontSize="11" Foreground="{StaticResource SoftText}" TextWrapping="Wrap" Margin="0,0,0,13" />
                    <CheckBox x:Name="EnabledCheck" Content="Enable this schedule" FontWeight="SemiBold" />
                    <TextBlock Text="Start time · your local clock" FontSize="11" Foreground="{StaticResource SoftText}" Margin="0,16,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Hour" FontSize="9" Foreground="{StaticResource SoftText}" />
                        <TextBlock Grid.Column="2" Text="Minute" FontSize="9" Foreground="{StaticResource SoftText}" />
                        <TextBlock Grid.Column="4" Text="AM / PM" FontSize="9" Foreground="{StaticResource SoftText}" />
                        <ComboBox x:Name="StartHourCombo" Grid.Row="2" MinHeight="40" ToolTip="Choose the hour" />
                        <ComboBox x:Name="StartMinuteCombo" Grid.Row="2" Grid.Column="2" MinHeight="40" ToolTip="Choose the minute" />
                        <ComboBox x:Name="StartPeriodCombo" Grid.Row="2" Grid.Column="4" MinHeight="40" ToolTip="Choose morning or evening" />
                    </Grid>

                    <TextBlock Text="Repeat on" FontSize="11" Foreground="{StaticResource SoftText}" Margin="0,15,0,6" />
                    <CheckBox x:Name="EveryDayCheck" Content="Every day" FontWeight="SemiBold"
                              Checked="EveryDayCheck_Changed" Unchecked="EveryDayCheck_Changed" />
                    <UniformGrid Rows="2" Columns="4" Margin="0,6,0,0">
                        <CheckBox x:Name="MondayCheck" Content="Mon" Margin="1,2" Checked="DayCheck_Changed" Unchecked="DayCheck_Changed" />
                        <CheckBox x:Name="TuesdayCheck" Content="Tue" Margin="1,2" Checked="DayCheck_Changed" Unchecked="DayCheck_Changed" />
                        <CheckBox x:Name="WednesdayCheck" Content="Wed" Margin="1,2" Checked="DayCheck_Changed" Unchecked="DayCheck_Changed" />
                        <CheckBox x:Name="ThursdayCheck" Content="Thu" Margin="1,2" Checked="DayCheck_Changed" Unchecked="DayCheck_Changed" />
                        <CheckBox x:Name="FridayCheck" Content="Fri" Margin="1,2" Checked="DayCheck_Changed" Unchecked="DayCheck_Changed" />
                        <CheckBox x:Name="SaturdayCheck" Content="Sat" Margin="1,2" Checked="DayCheck_Changed" Unchecked="DayCheck_Changed" />
                        <CheckBox x:Name="SundayCheck" Content="Sun" Margin="1,2" Checked="DayCheck_Changed" Unchecked="DayCheck_Changed" />
                    </UniformGrid>

                    <TextBlock Text="When the countdown ends" FontSize="11" Foreground="{StaticResource SoftText}" Margin="0,15,0,5" />
                    <ComboBox x:Name="ActionCombo" MinHeight="38" SelectionChanged="ActionCombo_SelectionChanged">
                        <ComboBoxItem Content="Sleep" />
                        <ComboBoxItem Content="Shut down" />
                        <ComboBoxItem Content="Restart" />
                        <ComboBoxItem Content="Lock" />
                        <ComboBoxItem Content="Close an app" />
                        <ComboBoxItem Content="Run a custom program" />
                    </ComboBox>

                    <StackPanel x:Name="CloseAppPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Choose an open app or enter its process name" FontSize="10"
                                   Foreground="{StaticResource SoftText}" Margin="1,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="OpenAppCombo" MinHeight="36" SelectionChanged="OpenAppCombo_SelectionChanged" />
                            <Button Grid.Column="2" Content="Refresh" MinHeight="36" Padding="10,4" Click="RefreshAppsButton_Click" />
                        </Grid>
                        <TextBox x:Name="ProcessNameBox" Margin="0,6,0,0" ToolTip="For example, chrome or qbittorrent" />
                    </StackPanel>

                    <StackPanel x:Name="RunProgramPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Program file" FontSize="10" Foreground="{StaticResource SoftText}" Margin="1,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ProgramPathBox" />
                            <Button Grid.Column="2" Content="Browse" MinHeight="36" Padding="10,4" Click="BrowseProgramButton_Click" />
                        </Grid>
                        <TextBlock Text="Arguments · optional" FontSize="10" Foreground="{StaticResource SoftText}" Margin="1,9,0,5" />
                        <TextBox x:Name="ProgramArgumentsBox" />
                    </StackPanel>

                    <CheckBox x:Name="SkipCountdownCheck" Content="Skip the countdown and go straight to the warning"
                              Margin="0,17,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="This uses the warning and snooze settings from the Warning tab. If warnings are off, the selected action runs at the scheduled time."
                               FontSize="9" Foreground="{StaticResource SoftText}" TextWrapping="Wrap" Margin="22,5,4,8" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="20,0,20,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="10" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Grid.Column="0" Content="Delete" MinHeight="38" Padding="12,5"
                        Background="{StaticResource DangerBackground}" BorderBrush="#805162" Foreground="{StaticResource DangerText}"
                        Visibility="Collapsed" Click="DeleteButton_Click" />
                <Button Grid.Column="2" Content="Cancel" MinHeight="38" Padding="10,5" Click="CancelButton_Click" IsCancel="True" />
                <Button Grid.Column="4" Content="Save" MinHeight="38" Padding="10,5"
                        Background="{StaticResource AccentViolet}" BorderBrush="#C5BCFF" Foreground="#17152D"
                        Click="SaveButton_Click" IsDefault="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
